# --- Mode ---
# false = real Aiven MySQL
USE_MOCK_DATA=false

# Password for /admin (add teachers + papers)
ADMIN_PASSWORD=change-me

# Same Aiven MySQL service as AI Fundry is fine —
# use a SEPARATE database name so projects don't clash.
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/lcwu_past_papers
DATABASE_SSL=true

# Then run: npm run db:setup

